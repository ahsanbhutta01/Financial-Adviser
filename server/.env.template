# Environment Variables Template for Financial Adviser
# Copy this file to server/.env and fill in your values

# Database Configuration
MONGO_URI=mongodb://mongodb:27017/financial_advisor

# Server Configuration  
PORT=8000
NODE_ENV=development

# Security Keys (CHANGE THESE FOR PRODUCTION!)
SECRET_KEY=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# AI API Keys
GEMINI_API=your_gemini_api_key_here
OPEN_ROUTER_API=your_openrouter_api_key_here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# URLs Configuration
CALLBACK_URL=http://localhost:8000/api/user/google/callback
FRONTEND_URL=http://localhost:5173

# Production URLs (for production environment)
# CALLBACK_URL=https://yourdomain.com/api/user/google/callback
# FRONTEND_URL=https://yourdomain.com
